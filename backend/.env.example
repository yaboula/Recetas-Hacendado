# Recetas Hacendado backend environment
# Copy this file to .env and replace placeholder values.
# Never commit real credentials.

# PostgreSQL connection string, for example Supabase.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Authentication
JWT_SECRET=replace_with_a_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Groq AI
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional product catalog import settings.
MERCADONA_IMPORT_SOURCE=dataset
MERCADONA_IMPORT_LIMIT=0
MERCADONA_ONLY_HACENDADO=false
MERCADONA_RECIPES_ONLY=false
MERCADONA_IMPORT_DELAY_MS=120
